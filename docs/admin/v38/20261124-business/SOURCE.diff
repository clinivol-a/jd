+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {orderMatches,recentOrders,orderActions,historyEvents,fileFormat,fileCategory,fileSize} from '../src/admin/orderRules.mjs';
+const day=v=>{const d=new Date(v);return Number.isNaN(+d)?'—':`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`};
+const base={id:'a',businessNo:'CV-2026-0001',createdAt:'2026-09-01T00:00:00+08:00',updated:'2026-11-24T08:00:00+08:00',status:'待审核',hospitalId:'h',department:'骨科',requestedStages:[0,1],leaderId:'lead'};
+const superadmin={id:'sa',role:'super_admin',permissions:['orders:review']};
+test('order filters combine AND, include local natural start/end dates, and match actual requested stage',()=>{const f={query:'CV-2026-0001',range:['2026-09-01','2026-11-24'],hospitalId:'h',department:'骨科',stage:'1',status:'待审核',leaderId:'lead'};assert(orderMatches(base,f,day));for(const change of [{query:'unknown'},{status:'已完成'},{hospitalId:'other'},{department:'外科'},{stage:'2'},{leaderId:'other'},{range:['2026-09-02','2026-11-24']}])assert(!orderMatches(base,{...f,...change},day));assert(orderMatches({...base,createdAt:'2026-11-24T23:59:59+08:00'},f,day));assert(!orderMatches({...base,createdAt:'bad'},f,day));assert(!orderMatches({...base,businessNo:undefined},{query:'a'},day));});
+test('home uses every authorized status, latest actual timestamp, stable ID ties, maximum seven, and does not mutate input',()=>{const states=['待审核','处理中','已完成','审核退回','已取消'];const rows=Array.from({length:10},(_,i)=>({...base,id:String(i),status:states[i%5],updated:new Date(Date.parse(base.updated)+i*1000).toISOString()}));const copy=structuredClone(rows);assert.deepEqual(recentOrders(rows,['2026-09-01','2026-11-24'],day).map(r=>r.id),['9','8','7','6','5','4','3']);assert.deepEqual(rows,copy);assert.equal(recentOrders(rows,['2026-10-01','2026-11-24'],day).length,0);assert.deepEqual(recentOrders([{...base,id:'b'},{...base,id:'a'}],[],day).map(r=>r.id),['a','b']);});
+test('More follows permissions, assignment, ownership and state, never treating task assignment as order review',()=>{assert.deepEqual(orderActions(base,superadmin),['change-leader','takeover']);assert.deepEqual(orderActions({...base,leaderId:'sa'},superadmin),['change-leader','accept','return']);assert.deepEqual(orderActions({...base,leaderId:null},superadmin),['assign-leader','takeover']);assert.deepEqual(orderActions({...base,status:'已完成'},superadmin),[]);assert.deepEqual(orderActions(base,{...superadmin,permissions:[]}),[]);assert.deepEqual(orderActions(base,{...superadmin,role:'leader'}),['change-leader']);});
+test('history identity dedup preserves separate same-title events and sorts epoch across timezones without changing audit data',()=>{const a={id:'a',title:'受理',at:'2026-01-01T10:00:00+08:00'},b={id:'b',title:'受理',at:'2026-01-01T02:30:00Z'};const events=[a,b,a],before=structuredClone(events);assert.deepEqual(historyEvents(events).map(e=>e.id),['b','a']);assert.deepEqual(events,before)});
+test('file metadata renders actual format/category/bytes without synthesizing a file or upload identity',()=>{assert.equal(fileFormat({name:'a.nii',type:'application/octet-stream'}),'NII');assert.equal(fileCategory({name:'a.nii'}),'医学影像');assert.equal(fileCategory({name:'a.pdf',category:'order-other'}),'其他附件');assert.equal(fileSize({size:1536}),'1.5 KB');assert.equal(fileSize({}),'—');});
+import {UnifiedBusinessService} from '../server/unified/service.mjs';
+test('incomplete asset linkage stays visible with an unknown stage instead of crashing the management snapshot',()=>{const service=new UnifiedBusinessService({directoryProvider:()=>({hospitals:[],doctors:[],people:[]})});service.state.orders.push({...base,plannedStages:['三维重建'],created:base.createdAt});service.state.artifacts.push({id:'asset-orphan',orderId:base.id,taskId:'missing-task',version:'1'});const result=service.adminSnapshot({...superadmin,status:'approved',permissions:['orders:read','assets:read']});assert.equal(result.assets.length,1);assert.equal(result.assets[0].stage,null);assert.equal(result.assets[0].taskId,'missing-task');assert.equal(service.state.events.length,0)});
+test('authorized hospital dictionary remains complete even when a hospital has no order yet; scope cannot expand',()=>{const service=new UnifiedBusinessService({directoryProvider:()=>({hospitals:[{id:'h1',name:'一院'},{id:'h2',name:'二院'}],doctors:[],people:[]})});const admin={...superadmin,status:'approved',permissions:['orders:read']};assert.equal(service.adminSnapshot(admin).hospitals.length,2);assert.deepEqual(service.adminSnapshot({...admin,role:'admin',hospitalIds:['h2']}).hospitals.map(h=>h.id),['h2']);assert.equal(service.state.events.length,0)});
+test('actual responsibility updates advance the order update timestamp, while stale commands cannot rewrite it',()=>{const at=Date.parse('2026-11-24T16:00:00+08:00');const s=new UnifiedBusinessService({now:()=>at});s.state.orders.push({...base,plannedStages:['三维重建'],version:1,created:base.createdAt});const actor={...superadmin,status:'approved',permissions:['orders:read','orders:review']};s.manage(actor,{action:'takeover',id:'a',version:1,reason:'隔离交接'});assert.equal(s.state.orders[0].updated,new Date(at).toISOString());assert.throws(()=>s.manage(actor,{action:'takeover',id:'a',version:1,reason:'旧请求'}));assert.equal(s.state.orders[0].version,2);assert.equal(s.state.events.length,1)});
