{
  "name": "clinivol-web-ux-prototype",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "auth:dev": "node server/auth/local-dev.mjs",
    "auth:server": "node server/auth/http.mjs",
    "test:auth": "node --experimental-strip-types --test tests/auth-service.test.mjs tests/auth-http.test.mjs tests/auth-storage.test.mjs tests/auth-console.test.mjs tests/auth-demo-scan.test.mjs tests/auth-targeted.test.mjs",
    "admin:dev": "node server/admin/dev.mjs",
    "test:admin": "node --test tests/admin-*.test.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tdesign-icons-react": "^0.6.11",
    "tdesign-react": "1.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vercel/blob": "^2.9.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  }
}
